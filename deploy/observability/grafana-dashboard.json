    {
      "type": "row",
      "title": "Caches, fallback and breaker",
      "collapsed": false,
      "id": 18,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 47
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cache hit ratio (gateway)",
      "description": "",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(finwise_ai_cache_total{hit=\"true\"}[10m])) / clamp_min(sum(rate(finwise_ai_cache_total[10m])), 1e-9)",
