      "collapsed": false,
      "id": 11,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "AI latency at the gateway (p50 / p95)",
      "description": "Red line = 20 s LLM-path budget. The deterministic (4 s) vs LLM split is only visible in k6.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
