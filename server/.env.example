# FinWise Server (.env)
# Copy to server/.env and adjust values.

NODE_ENV=development
PORT=3000

# Required
MONGO_URI=mongodb://localhost:27017/finwise
JWT_SECRET=development-jwt-secret

# Service URLs
PYTHON_API_URL=http://localhost:8001
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Redis / Worker (optional)
# Set REDIS_URL to enable BullMQ workers and distributed rate limiting/caching.
REDIS_URL=
WORKER_ENABLED=false
WORKER_CONCURRENCY=5
USAGE_AGGREGATION_CRON=0 * * * *
DIGEST_EMAIL_CRON=0 8 * * *
DIGEST_EMAIL_DAYS_BACK=7

# Cookies / CSRF
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
# If unset, CSRF defaults to true in production and false otherwise.
CSRF_ENABLED=false
CSRF_COOKIE_NAME=csrf_token

# Request limits
REQUEST_SIZE_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Feature flags
TASKS_ENABLED=true
RECEIPTS_OCR_ENABLED=true
JOURNAL_ENABLED=true
MONETIZATION_ENABLED=true
METRICS_ENABLED=false

# Tenancy maintenance (legacy backfills)
# If unset, defaults to false in production and true otherwise.
ORG_LEGACY_BACKFILL_ENABLED=true

# Uploads
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp
RECEIPT_UPLOAD_MAX_BYTES=8388608
JOURNAL_UPLOAD_MAX_BYTES=4194304

# Observability
LOG_LEVEL=info
METRICS_TOKEN=change-me-if-metrics-enabled

# Internal usage ingestion (optional)
USAGE_EVENTS_INTERNAL_TOKEN=change-me

# Internal AI tools token (optional; enables /api/internal/tools/* endpoints)
# Must match AI Core's FINWISE_TOOLS_TOKEN when configured.
AI_CORE_TOOLS_TOKEN=change-me-please-change

# API keys (optional)
API_KEY_PEPPER=

# Billing (optional; defaults to stub when Stripe keys are missing)
# Set BILLING_PROVIDER=stripe with Stripe test keys to enable real checkout flows.
BILLING_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_TEAM_SEAT=
STRIPE_PRICE_ENTERPRISE=

# AI core client controls
AI_CORE_MAX_CONCURRENCY=8
AI_CORE_MAX_CONCURRENCY_PER_USER=2
AI_CORE_STATUS_TIMEOUT_MS=2500
AI_CORE_TIMEOUT_MS=45000
AI_CORE_HEALTH_TIMEOUT_MS=2500
AI_CORE_CIRCUIT_FAILURE_THRESHOLD=3
AI_CORE_CIRCUIT_OPEN_MS=30000
AI_CORE_HEALTH_CACHE_MS=5000

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Email (optional; in dev you can run in console OTP mode)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SERVICE=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
