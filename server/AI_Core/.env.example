# FinWise AI Core (.env)
# Copy to server/AI_Core/.env and adjust values.

# Optional (AI Core will run in deterministic fallback mode without it)
GEMINI_API_KEY=
# Gemini is the only supported LLM provider in this project.

MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Optional cost estimation (USD per 1K tokens). Defaults to 0.
LLM_COST_USD_PER_1K_INPUT_TOKENS=0
LLM_COST_USD_PER_1K_OUTPUT_TOKENS=0

# CORS for AI Core (server-to-ai-core is same-machine in local dev)
AI_CORE_ALLOWED_ORIGINS=http://localhost:3000

# Optional server tool-host integration (enables AI tool validation and future autonomous flows)
FINWISE_SERVER_URL=http://localhost:3000
FINWISE_TOOLS_TOKEN=change-me-please-change

# Vision (OCR + handwriting)
VISION_LANG_DEFAULT=en
VISION_LANG_ALLOWED=en
VISION_MAX_IMAGE_BYTES=10485760

# Observability
LOG_LEVEL=INFO

# Metrics (Prometheus)
# When set, /metrics requires: Authorization: Bearer <token>
AI_CORE_METRICS_TOKEN=
