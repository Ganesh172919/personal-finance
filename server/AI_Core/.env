GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=

# ─── Provider Selection ───────────────────────────────────
# Set to: gemini | openrouter | groq | grok | together | mistral
# If empty, auto-detects from the first API key that is set.
LLM_PROVIDER=

# Override the provider's default model (optional).
# Examples:
#   gemini:     gemini-2.5-flash
#   openrouter: google/gemini-2.0-flash-exp:free
#   groq:       llama-3.3-70b-versatile
#   grok:       grok-3-mini-fast
#   together:   meta-llama/Llama-3.3-70B-Instruct-Turbo
#   mistral:    mistral-small-latest
LLM_MODEL=

# Legacy fallback candidates (used when provider is gemini and no LLM_MODEL is set)
MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# ─── LLM Parameters ──────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=0

# ─── Vision / OCR ────────────────────────────────────────
VISION_MAX_IMAGE_BYTES=10485760
VISION_LANG_ALLOWED=en
VISION_LANG_DEFAULT=en

# ─── Memory ──────────────────────────────────────────────
FINWISE_MEMORY_DB_PATH=
FINWISE_MEMORY_TOP_K=8

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
