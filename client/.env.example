# ══════════════════════════════════════════════════════════════════════
# FinWise Client — Environment Configuration
# ══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# All VITE_ variables are exposed to the client bundle at build time.
# ══════════════════════════════════════════════════════════════════════

# ── API Configuration ────────────────────────────────────────────────
# Base URL for API requests (default: /api — proxied in dev)
# Type: string    Default: /api
VITE_API_BASE_URL=/api

# Dev server proxy target (where the Express server runs)
# Type: string    Default: http://localhost:3000
VITE_API_PROXY_TARGET=http://localhost:3000

# ── Application ──────────────────────────────────────────────────────
# App display name (used in PWA manifest, browser tab, etc.)
# Type: string    Default: FinWise
VITE_APP_NAME=FinWise
